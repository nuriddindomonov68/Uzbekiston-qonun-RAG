# Application Configuration
APP_NAME=AI Data Analysis Agent
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest

# Storage Configuration
